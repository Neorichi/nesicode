# Model provider keys (users can also add their own in the web UI)
NESILABS_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ZAI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1
# NESICODE_COMPAT_BASE_URL=http://localhost:8000/v1
# NESICODE_COMPAT_API_KEY=

# Defaults for new projects
NESICODE_EXECUTOR_MODEL=nesilabs/nesi3
NESICODE_IMPROVER_MODEL=nesilabs/nesi3

# Server
NESICODE_DATA_DIR=./data
NESICODE_SANDBOX=auto             # auto (macOS sandbox cage) | docker | none
NESICODE_DOCKER_IMAGE=python:3.12-slim
NESICODE_DOCKER_NETWORK=none
NESICODE_SECRET_KEY=              # encrypts stored API keys; auto-generated in data dir if empty
NESICODE_COOKIE_SECURE=0          # 1 behind HTTPS
NESICODE_AUTH=false              # true = login screen + multi-user accounts
# NESICODE_LOCAL_USER=             # account used when auth is off (email); empty = first account
NESICODE_ALLOW_SIGNUP=1
NESICODE_MAX_JOBS=4
NESICODE_ROLLOUT_WIDTH=4

# Vault for user API keys (AES-256-GCM envelope encryption). The master key lives outside the
# DB and outside every agent cage: ~/.nesicode/vault.key by default, or inject it from a secret manager.
# NESICODE_VAULT_KEY=                # base64 of 32 random bytes
# NESICODE_VAULT_KEY_FILE=~/.nesicode/vault.key
NESICODE_ALLOW_PRIVATE_PROVIDERS=1  # set 0 on multi-user servers (blocks provider endpoints on private networks)
# NESICODE_VISION_MODEL=anthropic/claude-sonnet-5-5
