# Model provider keys (users can also add their own in the web UI)
NESILABS_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ZAI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1
# NESICODE_COMPAT_BASE_URL=http://localhost:8000/v1
# NESICODE_COMPAT_API_KEY=

# Defaults for new projects
NESICODE_EXECUTOR_MODEL=nesilabs/nesi3
NESICODE_IMPROVER_MODEL=nesilabs/nesi3

# Server
NESICODE_DATA_DIR=./data
NESICODE_SANDBOX=auto             # auto (macOS sandbox cage) | docker | none
NESICODE_DOCKER_IMAGE=python:3.12-slim
NESICODE_DOCKER_NETWORK=none
NESICODE_SECRET_KEY=              # encrypts stored API keys; auto-generated in data dir if empty
NESICODE_COOKIE_SECURE=0          # 1 behind HTTPS
NESICODE_AUTH=false              # true = login screen + multi-user accounts
# NESICODE_LOCAL_USER=             # account used when auth is off (email); empty = first account
NESICODE_ALLOW_SIGNUP=1
NESICODE_MAX_JOBS=4
NESICODE_ROLLOUT_WIDTH=4

# Vault for user API keys (AES-256-GCM envelope encryption). The master key lives outside the
# DB and outside every agent cage: ~/.nesicode/vault.key by default, or inject it from a secret manager.
# NESICODE_VAULT_KEY=                # base64 of 32 random bytes
# NESICODE_VAULT_KEY_FILE=~/.nesicode/vault.key
NESICODE_ALLOW_PRIVATE_PROVIDERS=1  # set 0 on multi-user servers: user endpoints, connectors, git clones and imports
                                    # must be public addresses (checked when saved and on every connection)
# NESICODE_VISION_MODEL=anthropic/claude-sonnet-5-5
# NESICODE_IMAGE_MODEL=

# Browser access. Without login, only IPs, localhost, single-label and .local host names are answered (DNS rebinding):
# NESICODE_ALLOWED_HOSTS=nesi.example.com,.example.com   # domain names to serve too ('*' = any; with login it enables the check)
# NESICODE_ALLOWED_ORIGINS=https://nesi.example.com      # other origins allowed to send state-changing requests (CSRF check)

# Model streams: retry a reply that stays silent this long (seconds)
# NESICODE_LLM_FIRST_BYTE_TIMEOUT=300   # before the first token (slow prompt processing, long hidden reasoning)
# NESICODE_LLM_IDLE_TIMEOUT=180         # between two chunks of a reply

# Extra folders caged commands may never read or write (colon-separated)
# NESICODE_SANDBOX_DENY=/srv/secrets:/Users/me/clients
